{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runehaven Mac Launcher",
  "mainBinaryName": "Runehaven Mac Launcher",
  "version": "0.1.0",
  "identifier": "io.github.starwatcherr.rml",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Runehaven Mac Launcher",
        "width": 1000,
        "height": 640,
        "minWidth": 880,
        "minHeight": 640,
        "theme": "Dark",
        "backgroundColor": "#16191F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "category": "Game",
    "copyright": "Project by Starwatcherr. Unofficial, not affiliated with Cikoria.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "resources": {
      "../../inputfix/build/version.dll": "version.dll",
      "../../macfix/build/app/rml-macfix.dylib": "rml-macfix.dylib"
    }
  }
}
